# biblioteca de functiones climáticas
#
# display co2, ch4, and surface temperature data
climad () {
    echo
    date -u
    echo
    print "Greenhouse gas data:\n"
    source ~/bin/latestco2.sh
    echo
    source ~/bin/co2trends_webdata.sh
    echo
    ~/.local/bin/uv run --with requests --with bs4 gosatghgdata.py
    print "Air temperature data:\n"
    source ~/bin/nsatdaily.sh
    echo
    print "Sea surface temperature data:\n"
    source ~/bin/sstdaily.sh
    echo
}
